.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Local tool settings
.claude/

# auto-generated findsym/smodes caches from CLI runs in the repo root.
# A PATTERN, not a list of names: this was six specific filenames, and every
# new material or sweep leaked another one (a single coupled-freeze sweep
# added BaTiO3_findsym, CMO_findsym, HfO2_findsym, STO_findsym, TiO2_findsym
# and graphite_findsym). The tag is material-derived, so the set is open.
/*_findsym
/*_smodes_*
/findsym.log
/findsym.cif

# Logs the ISOTROPY binaries write into whatever directory they are invoked
# from. `run_findsym`/`run_iso` use a temp cwd so the package never creates
# these, but a manual run in the repository root would -- and an `iso.log`
# reached a commit that way once already.
findsym.log
findsym.cif
iso.log
# ...except the saved logs the tests read.
!tests/fixtures/**/findsym.log
!tests/fixtures/**/findsym.cif

# macOS
.DS_Store
